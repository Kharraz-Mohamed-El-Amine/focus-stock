# =============================================================================
# Focus Stock & Transport - Modèle de Configuration d'Environnement (.env.example)
# =============================================================================
# Instructions :
# 1. Copiez ce fichier sous le nom .env :
#      cp .env.example .env  (Linux/Mac) ou copy .env.example .env (Windows)
# 2. Renseignez les mots de passe sécurisés souhaités pour les comptes de test.
# 3. Ce fichier .env ne doit JAMAIS être versionné dans Git.
# =============================================================================

# Mots de passe initiaux pour la commande "python manage.py seed_users"
SEED_SUPERVISOR_PASSWORD=votre_mot_de_passe_superviseur_securise
SEED_CHEF_EQUIPE_PASSWORD=votre_mot_de_passe_chef_equipe_securise

# Noms alternatifs optionnels
# SUPERVISOR_PASSWORD=
# CHEF_EQUIPE_PASSWORD=

# Paramètres Django optionnels (pour déploiement futur)
# SECRET_KEY=votre_cle_secrete_django
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
